{
  "entities": {
    "users": {
      "title": "Users",
      "description": "User profile with role assignment for C-FEWA platform",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string" },
        "region": { "type": "string" },
        "organization": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "email", "role"]
    },
    "alerts": {
      "title": "Disaster Early Warning Alerts",
      "description": "AI-triggered climate disaster and flood risk alerts",
      "properties": {
        "title": { "type": "string" },
        "severity": { "type": "string" },
        "location": { "type": "string" },
        "floodRiskPercent": { "type": "number" },
        "description": { "type": "string" },
        "status": { "type": "string" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["title", "severity", "location", "status"]
    },
    "inventory_stocks": {
      "title": "Food Supply Chain Inventory",
      "description": "Real-time visibility into food stocks across farms, traders, and government warehouses",
      "properties": {
        "facilityName": { "type": "string" },
        "ownerName": { "type": "string" },
        "role": { "type": "string" },
        "itemType": { "type": "string" },
        "quantity_kg": { "type": "number" },
        "capacity_kg": { "type": "number" },
        "status": { "type": "string" },
        "location": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["facilityName", "itemType", "quantity_kg", "status"]
    },
    "nutrition_logs": {
      "title": "Child Nutrition Intake Logs",
      "description": "PAGi / LaPaQ child nutrition and school meal tracking logs",
      "properties": {
        "schoolOrKitchenName": { "type": "string" },
        "childCount": { "type": "number" },
        "mealServed": { "type": "string" },
        "nutritionScore": { "type": "number" },
        "stuntingRiskCount": { "type": "number" },
        "disasterDisruptionActive": { "type": "boolean" },
        "loggedBy": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["schoolOrKitchenName", "childCount", "mealServed"]
    },
    "community_actions": {
      "title": "Community Preparedness & Stock Repositioning Actions",
      "description": "Coordinates response actions delivered via Fellas network",
      "properties": {
        "alertId": { "type": "string" },
        "actionTitle": { "type": "string" },
        "assignedRole": { "type": "string" },
        "location": { "type": "string" },
        "status": { "type": "string" },
        "volunteersCount": { "type": "number" },
        "timestamp": { "type": "string" }
      },
      "required": ["actionTitle", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "users",
      "description": "User profiles with assigned roles"
    },
    "/alerts/{alertId}": {
      "schema": "alerts",
      "description": "Disaster early warning alerts"
    },
    "/inventory_stocks/{stockId}": {
      "schema": "inventory_stocks",
      "description": "Food supply chain inventory stocks"
    },
    "/nutrition_logs/{logId}": {
      "schema": "nutrition_logs",
      "description": "Child nutrition intake logs"
    },
    "/community_actions/{actionId}": {
      "schema": "community_actions",
      "description": "Community preparedness and stock repositioning actions"
    },
    "/weather_data/{dataId}": {
      "schema": "weather_data",
      "description": "Weather data feeds"
    }
  }
}
